{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fabready",
  "version": "0.2.0",
  "identifier": "io.github.restuindrawan.fabready",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "fabready",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 23 },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Restu Indrawan. MIT License.",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Pre-order checks for KiCad PCBs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
