<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>fabready third-party licenses</title>
  <style>
    body { font: 14px/1.5 -apple-system, system-ui, sans-serif; max-width: 860px; margin: 40px auto; padding: 0 20px; }
    pre { white-space: pre-wrap; background: #f4f4f5; padding: 12px; border-radius: 6px; font-size: 12px; }
    li { margin: 2px 0; }
  </style>
</head>
<body>
  <h1>Third-party licenses</h1>
  <p>fabready is MIT-licensed. It includes the following open-source components.</p>
  <h2>Overview</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  <h2>Licenses</h2>
  {{#each licenses}}
  <h3 id="{{id}}">{{name}}</h3>
  <p>Used by:</p>
  <ul>
    {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
    {{/each}}
  </ul>
  <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
